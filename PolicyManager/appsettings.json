{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=False"
  },
  "Outbox": {
    "BatchSize": 20,
    "LockDuration": "00:00:30",
    "BusyDelay": "00:00:00.250",
    "MinIdleDelay": "00:00:01",
    "MaxIdleDelay": "00:00:30",
    "BaseRetryDelay": "00:00:05",
    "MaxRetryDelay": "00:10:00",
    "MaxAttempts": 5
  },
  "Pii": {
    "AuditAccess": true
  },
  "Jwt": {
    "Issuer": "policy-manager",
    "Audience": "policy-manager-api",
    "ClockSkewSeconds": 30,
    "RequireKnownRole": true
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "Window": "00:01:00",
    "Cooldown": "00:00:10",
    "QueueLimit": 20,
    "MaxRequestBodySizeBytes": 65536,
    "RejectionStatusCode": 429
  },
  "AllowedHosts": "*"
}
