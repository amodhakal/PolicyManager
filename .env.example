DB_PASSWORD=xxxxxxx
DB_HOST=localhost,14330
DB_NAME=PolicyManager
DB_USER=SA

# Message broker for the transactional outbox. Set BROKER_ENABLED=true to have the API
# publish outbox messages to RabbitMQ instead of the in-process logging stand-in. Leave
# it false (the default) and no broker is needed for `dotnet test` or local development.
BROKER_ENABLED=false
BROKER_HOST=localhost
BROKER_PORT=5672
BROKER_USERNAME=guest
BROKER_PASSWORD=guest
BROKER_VHOST=/
BROKER_QUEUE_NAME=policy-manager.outbox
